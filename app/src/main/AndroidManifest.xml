<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required only for the optional remote-Ollama backend. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Foreground service used to keep transcription running while the
         activity is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>

    <!-- API 33+ requires runtime permission to post notifications. We
         request it on first share; denial means transcription still runs,
         just without progress notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:name=".TranscriptionApplication"
        android:label="@string/app_name"
        android:theme="@style/Theme.Transcription"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Receive audio shared from WhatsApp / any other app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="audio/*"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".TranscriptActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="@string/action_diagnostics"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity"/>

        <service
            android:name=".TranscriptionService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
    </application>
</manifest>
